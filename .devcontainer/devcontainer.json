{
    "name": "v2k",
    "image": "ghcr.io/blabtm/v2k.dev:latest",

    "runArgs": ["--network=host"],

    "mounts": [
        "source=/etc/localtime,target=/etc/localtime,readonly,type=bind",
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,readonly,type=bind",
        "source=gradle-cache,target=/home/vscode/.gradle,type=volume",
        "source=vcpkg-cache,target=/home/vscode/.vcpkg-cache,type=volume"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-containers",
                "task.vscode-task",
                "-vscjava.vscode-java-pack"
            ]
        }
    }
}
